# webserv.conf — example configuration
# ──────────────────────────────────────────────────────────────────────────────
# Directive reference:
#   host            <ip>                    default: 0.0.0.0
#   port            <number>                default: 8080
#   server_name     <name> [name …]
#   root            <path>
#   index           <file> [file …]
#   max_body        <bytes|K|M|G>           default: 1M
#   error_page      <code> <path>
#
#   location <path> {
#       methods       <GET|POST|DELETE> …
#       root          <path>
#       autoindex     on|off
#       index         <file> [file …]
#       upload_enable on|off
#       upload_store  <path>
#       redirect      <code> <url>
#       cgi           <.ext> <interpreter>
#   }
# ──────────────────────────────────────────────────────────────────────────────

server {
    host        0.0.0.0;
    port        8080;
    server_name localhost webserv.local;

    root        ./www;
    index       index.html index.htm;
    max_body    10M;

    error_page  404 ./www/errors/404.html;
    error_page  500 ./www/errors/500.html;

    # ── static files ──────────────────────────────────────────────────────────
    location / {
        methods   GET;
        autoindex off;
        index     index.html;
    }

    # ── file uploads ──────────────────────────────────────────────────────────
    location /uploads {
        methods       GET POST DELETE;
        autoindex     on;
        upload_enable on;
        upload_store  ./www/uploads;
    }

    # ── redirect ──────────────────────────────────────────────────────────────
    location /old {
        redirect 301 /;
    }

    # ── CGI ───────────────────────────────────────────────────────────────────
    location /cgi-bin {
        methods GET POST;
        root    ./www;
        cgi     .py /usr/bin/python3;
        cgi     .sh /bin/sh;
    }
}

# Second virtual server on a different port
server {
    host        0.0.0.0;
    port        8081;
    server_name api.local;

    root        ./www/api;
    max_body    1M;

    location / {
        methods GET POST DELETE;
        index   index.html;
    }
}
