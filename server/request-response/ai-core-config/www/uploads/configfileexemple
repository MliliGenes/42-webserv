server {
    host        127.0.0.1
    port        8080
    server_name mysite.com
    client_max_body_size 10m

    error_page 404 /errors/404.html
    error_page 500 /errors/500.html

    root  ./www
    index index.html index.htm

    location / {
        methods     GET
        root        ./www
        index       index.html
        autoindex   off
    }

    location /upload {
        methods         POST
        upload_enable   on
        upload_store    ./uploads
    }

    location /files {
        methods     GET DELETE
        root        ./uploads
        autoindex   on
    }

    location /api {
        methods     GET POST
        root        ./api
    }

    location /old-page {
        return 301 /new-page
    }

    location /docs {
        methods     GET
        root        ./docs
        autoindex   on
        index       README.html
    }
}


    ############ ############ ############
############ how should be parsed ############
    ############ ############ ############

ServerConfig {
    host:              "127.0.0.1"
    port:              8080
    serverNames:       ["mysite.com"]
    clientMaxBodySize: 10485760      (10 * 1024 * 1024)
    root:              "./www"
    index:             ["index.html", "index.htm"]
    errorPages:        { 404: "/errors/404.html",
                         500: "/errors/500.html" }

    routes: [
        LocationConfig {
            path:      "/"
            methods:   { "GET" }
            root:      "./www"
            index:     ["index.html"]
            autoindex: false
            redirect:  { enabled: false }
        },
        LocationConfig {
            path:         "/upload"
            methods:      { "POST" }
            uploadEnable: true
            uploadStore:  "./uploads"
            redirect:     { enabled: false }
        },
        LocationConfig {
            path:      "/files"
            methods:   { "GET", "DELETE" }
            root:      "./uploads"
            autoindex: true
            redirect:  { enabled: false }
        },
        LocationConfig {
            path:      "/api"
            methods:   { "GET", "POST" }
            root:      "./api"
            redirect:  { enabled: false }
        },
        LocationConfig {
            path:      "/old-page"
            redirect:  { enabled: true,
                         code:    301,
                         url:     "/new-page" }
        },
        LocationConfig {
            path:      "/docs"
            methods:   { "GET" }
            root:      "./docs"
            autoindex: true
            index:     ["README.html"]
            redirect:  { enabled: false }
        }
    ]
}