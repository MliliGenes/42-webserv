[
    {
        "server": {
            "host": "127.0.0.1",
            "port": 8080,
            "server_name": "localhost",
            "root": "./www",
            "locations": [
                {
                    "path": "/",
                    "methods": [
                        "GET"
                    ],
                    "index": [
                        "index.html"
                    ],
                    "cgi": {
                        ".php": "/usr/bin/php-cgi",
                        ".py": "/usr/bin/python3",
                        ".sh": "/usr/bin/perl",
                        ".js": "/usr/bin/node"
                    }
                }
            ]
        }
    }
]