[
    {
        "server": {
            "host": "127.0.0.1",
            "port": 8080,
            "server_name": ["localhost"],
            "root": "www/",
            "index": ["index.html"],
            "client_max_body_size": "10M",

            "locations": [
                {
                    "path": "/",
                    "methods": [
                        "GET"
                    ],
                    "autoindex": true,
                    "index": [
                        "index.html"
                    ],
                    "cgi": {
                        ".php": "/usr/bin/php-cgi",
                        ".py": "/usr/bin/python3",
                        ".sh": "/usr/bin/perl",
                        ".js": "/usr/bin/node"
                    }
                }
            ]
        }
    }
]